# ==== Supabase ====
# من supabase/config.toml [api] external_url (محليًا: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key من supabase start>
# مفتاح الخدمة — للخادم فقط، لا يُستورد في أي ملف يصل للعميل
SUPABASE_SERVICE_ROLE_KEY=<service-role-key من supabase start>

# ==== أسرار عامة ====
# سر حماية عامل الوظائف الخلفية (توليد: openssl rand -hex 32)
CRON_SECRET=<عشوائي>
# مفتاح تشفير بيانات الربط AES-256-GCM (32 بايت hex)
INTEGRATIONS_ENCRYPTION_KEY=<عشوائي 64 حرفًا hex>

# ==== تكاملات خارجية (تبقى فارغة حتى الاعتماد الرسمي) ====
# MOYASAR_SECRET_KEY=
# MOYASAR_PUBLISHABLE_KEY=
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_PHONE_ID=
# TTLOCK_CLIENT_ID=
# TTLOCK_CLIENT_SECRET=
